[Unit]
Description=VK 射手座控制中心 · 后台守护进程（vksagd）
Documentation=https://github.com/lubuoren/vk-sagittarius
# 只操作 hidraw，不需要图形会话；登出也不该停
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/vksagd
Restart=on-failure
RestartSec=3
# 设备权限靠 udev 的 uaccess / input 组
# 日志：journalctl --user -u vk-sagittarius -f
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

[Install]
WantedBy=default.target
